
-- x
let
cpPat = s "cp" # gain 0.7
-- pat
notePat = n "[0 1 0@5 . ~]*4" # s "violin" # legato 1
-- finalPat
finalPat = stack [
  cpPat,
  notePat
  ]
seqPLoopPat = seqPLoop [
  (0, 900, finalPat),
  (996, 1000, gain "0.8 0.5" # s "hc hc")
  ]
in do
  hush
  setcps 0.44
  setCycle 0
  d1 $ seqPLoopPat
