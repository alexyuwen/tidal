
-- 16/3
-- 1+72 cycles, 2'43"    -- ABACADEEA 48: mix  64: A' out, both voices  72
-- This one falls into a neat ABACADEEA' where each section is 8 bars long (1 ostinato = 1 bar). The volta occurs at the two-thirds mark.
-- B, C, D displace the ostinato by a random amount chosen each bar. E continues this displacement but randomly alternates 50/50 with the original non-displaced every 3/16 bar, creating a long hemiola, but one that is more structural than perceptual given the randomness of the alternation.
let
-- vPat
vS = s "violin" # gain (0.8 * (sew "[t t f t f t t f]*2" "[0.8|0.7|0.6]*16" 0.99))
vN = n (scale "harmonicMinor" "0 2 4 0 5 3 1 5 . 0 2 4 0 3 1 -1 3")
vN2 = n (sew "<t!16 f!16>" (-0.2) 0.2)
vPat1a = vN # vS # vowel "x" # octave 5
vPat1b = vPat1a |+ vN2
vPat1 = stack [vPat1a, vPat1b] -- detuned
vPat2 = (<~) (segment 1 $ irand 16 / 16) vPat1 # vowel "u"
vPat = sew "<t!8 f!56 t!8>" vPat1a $ sew (sew "<t!48 f!16 t!8>" "<t!8 f!8>" "[t|f]*16/3") vPat1 vPat2 -- intro, rondo
-- bs
bs = n "c/2" # octave 3 # s "supermandolin" # vowel "u" # legato 6.9 # gain 0.82 # cut 1 # room 1 # orbit 2
-- drums
whileF x = while "<f f f t f [f t] f [f f t]>" (ply "[2|1|1|1|1]*16") x
hhMid = whileF "1!16" # s "hc:0" # hpf 4444 # cut 1 # gain 0.69
hhHigh = whileF "1!16" # s "hc:0" # hpf 9999 # cut 1 # gain 0.8
hh = sew "<t!8 f!8>" hhMid hhHigh
kick = "<[1@3 1@5] ~>" # s (sew "<t!8 f!8>" "bskick:2" "rolandd70-bd:0") # speed 1 # gain 1 -- TODO something bskick:2
sd = "~ . ~ <~ 1 ~ ~  ~ 1 ~ 1>" # s "snare:0" # gain 1 # speed 1.1
-- final pats
hc = gain "0.8 0.5" # s "hc hc" -- countoff
vSew = sew (sew "<t f t f t f t f>" "t f" "t f t f") vPat1a (vPat1 # vowel "u")
rhythm = stack [
  hh,
  kick,
  sd
  ]
finalPat = stack [
  sew "<t!64 f!8>" vPat vSew,
  bs,
  rhythm
  ]
seqPLoopPat = seqPLoop [
  (0, 72, finalPat),
  (992, 999, hc),
  (999, 1000, "1 1 1 1" # s "hc:0" # hpf 4444 # gain 0.6)
  ]
in do
  hush
  setcps 0.44
  setCycle 32
  d1 $ seqPLoopPat
