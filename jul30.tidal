--
-- This one is inspired by Croation string bands. This one continues the tempo of the previous two as well as the pattern of increasing subdivision: 8, 9, 10.
-- TODO violin harmonizations
let
-- violins
-- v
vS = s "violin" # vowel "i" # octave 6 # legato 0.88 # gain 0.72
vN = n (scale "major" "[[1, 3] ~ [3, 5] ~ 1 . [0, 2] ~ [2, 4] ~ 0 . [0, 1] ~ [1, 3] ~ -1 . <[0 ~ 1 ~ 2] [0 ~ ~ ~ ~] [0 ~ 1 ~ 2] [0 ~ 1 ~ 2]>]")
v = vN # vS
-- v2
v2S = s "violin" # vowel "u" # octave 7 # legato 0.88 # gain 0.77
v2N = n (scale "major" "7 ~ 7 6 5 . 4 ~ 4 3 2 . 3 ~ 3 2 1 . <[2 3 4 ~ 0] [2 ~ ~ ~ ~] [2 3 4 ~ 0] [0 ~ ~ ~ ~]>")
v2 = v2N # v2S
-- bs TODO
bs = n (scale "major" "7 7") # octave 3 # s "supermandolin" # vowel "u" # legato 2 # gain 0.99 # cut 1 # room 0.2 # orbit 2
-- gtr
gtr = n (scale "major" "[[-4] ~ [-4, -2, 1] ~ ~ . ~ ~ [-3, 0, 2] ~ ~ . ~ ~ [-3, -1, 1] ~ ~ . [0, 2] ~ ~ ~ ~]") # s "supermandolin" # vowel "i" # legato 1.2 # lpf 6666 # gain 0.99 # room 0.12 # orbit 5
-- rhythm
hh = s "hc:0" # vowel "a" # cut 1 # gain 0.77 # orbit 4
-- hhMid = "[1@2 1@3]*4" # hh
hhMask = mask (fast 6.9 $ wchoose [(False, 1), (True, 15)])
hhSew = sew "<t t t [t@3 f]>" ((<~) (segment 1 $ irand 20 / 20) "1([11|12|13],20)") "[1 _ 1 _ 1]*4"
hhN = n hhSew
hhPat = hhMask $ hhN # hh
kick = "[~ _ 1 _ _]*4" # s "bskick:2" # vowel "i" # speed 1 # gain 0.8 # room 0.12 # orbit 3
sd = n "1 1" # s "snare:0" # gain 0.54 # speed 1.1
-- final
final = stack [
  v,
  v2,
  gtr,
  bs
  -- kick
  -- hhPat
  ]
seqPLoopPat = seqPLoop [
  (0, 900, final),
  (992, 999, gain "0.8 0.5" # s "hc hc"),
  (999, 1000, "1 1 1 1" # s "hc:0" # hpf 4444 # gain 0.6) -- TODO Shorten countoff to beat 4, 3 hh hits
  ]
in do
  hush
  setcps 0.44
  setCycle 0
  d1 $ seqPLoopPat
