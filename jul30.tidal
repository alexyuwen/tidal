
--
let
-- violin
vN = n (scale "major" $ stack [
  "[3 ~ 5 ~ 1 . 2 ~ 4 ~ 0 . 1 ~ 3 ~ -1 . 0 ~ 1 ~ 2]"
  ])
v = vN # s "violin" # vowel "i" # octave 6 # gain 0.8
-- bs
bs = n "0" # octave 3 # s "supermandolin" # vowel "u" # legato 1.66 # gain 0.9 # cut 0 # room 0.33 # orbit 2
-- rhythm
hhMid = "[1@2 1@3]*4" # s "hc:0" # hpf 4444 # cut 1 # gain 0.54 # orbit 4
kick = "1 1" # s (sew "<t f t f>" "rolandd70-bd:0" "bskick:2") # vowel "u" # speed 1 # gain (0.92 * (sew "<t f t f>" 0.92 0.88)) # room 0.12 # orbit 3
sd = n "1 1" # s "snare:0" # gain 0.54 # speed 1.1
-- final
final = stack [
  hhMid,
  v
  ]
seqPLoopPat = seqPLoop [
  (0, 900, final),
  (992, 999, gain "0.8 0.5" # s "hc hc"),
  (999, 1000, "1 1 1 1" # s "hc:0" # hpf 4444 # gain 0.6)
  ]
in do
  hush
  setcps 0.44
  setCycle 0
  d1 $ seqPLoopPat
