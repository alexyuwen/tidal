
-- TODO grid warp, rush beat 2
-- Croation string bands
let
-- violin
vN = n (scale "major" $ stack [
  "[3 ~ 5 ~ 1 . 2 ~ 4 ~ 0 . 1 ~ 3 ~ -1 . 0 ~ 1 ~ 2]"
  ])
v = vN # s "violin" # vowel "i" # octave 6 # legato 0.88 # gain 0.77
-- bs
bs = n "0" # octave 3 # s "supermandolin" # vowel "u" # legato 1.66 # gain 0.9 # cut 0 # room 0.33 # orbit 2
-- gtr
gtr = n "[0]*4" # s "supermandolin" # vowel "x" # legato 0.5 # gain 0.99
-- rhythm
hh = s "hc:0" # vowel "a" # cut 1 # gain 0.77 # orbit 4
-- hhMid = "[1@2 1@3]*4" # hh
hhMask = mask (fast 6.9 $ wchoose [(False, 1), (True, 15)])
hhSew = sew "<t t t [t@3 f]>" ((<~) (segment 1 $ irand 20 / 20) "1([11|12|13],20)") "[1 _ 1 _ 1]*4"
hhN = n hhSew
hhPat = hhMask $ hhN # hh
kick = "[~ _ 1 _ _]*4" # s "bskick:2" # vowel "i" # speed 1 # gain 0.8 # room 0.12 # orbit 3
sd = n "1 1" # s "snare:0" # gain 0.54 # speed 1.1
-- final
final = stack [
  v,
  -- gtr,
  -- kick,
  hhPat
  ]
seqPLoopPat = seqPLoop [
  (0, 900, final),
  (992, 999, gain "0.8 0.5" # s "hc hc"),
  (999, 1000, "1 1 1 1" # s "hc:0" # hpf 4444 # gain 0.6) -- TODO Shorten countoff to beat 4, 3 hh hits
  ]
in do
  hush
  setcps 0.44
  setCycle 0
  d1 $ seqPLoopPat
