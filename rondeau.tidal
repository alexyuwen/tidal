
-- rondeau
let
-- vPat
vPat1 = n (scale "harmonicMinor" "0 2 4 0 5 3 1 5 . 0 2 4 0 3 1 -1 3") # s "violin" # octave 5 # gain (sew "[t t f t f t t f]*2" "[0.8|0.7|0.6]*16" 0.99)
vPat2 = (<~) (segment 1 $ irand 16 / 16) vPat1 # vowel "u"
vPat = sew "<f!8 f!8>" vPat1 vPat2
-- drums
hihat0 = while "<f f f t f [f t] f [f f t]>" (ply "[1|1|1|1|2]*16") "1!16" # s "hc:0" # hpf 4444 # cut 1
kick = "<[1@3 1@5] ~>" # s "bskick:2" # speed 1.1 # gain 1.2
sd = "~ . ~ <~ 1 ~ ~  ~ 1 ~ 1>" # s "snare:0" # gain 1.45 # speed 1.1
-- bs
bs = n "c/2" # octave 3 # s "supermandolin" # vowel "u" # legato 7 # cut 1 # room 1 # orbit 2
-- finalPat
finalPat = stack [
  vPat2,
  hihat0,
  kick,
  sd,
  bs
  ]
seqPLoopPat = seqPLoop [
  (0, 900, finalPat),
  -- (0, 900, finalPat),
  (996, 1000, gain "0.8 0.5" # s "hc")
  ]
in do
  hush
  setcps 0.44
  setCycle 0
  d1 $ seqPLoopPat
