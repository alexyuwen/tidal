
-- rondeau
let
-- vPat
vPat1a = n (scale "harmonicMinor" "0 2 4 0 5 3 1 5 . 0 2 4 0 3 1 -1 3") # s "violin" # vowel "x" # octave 5 # gain (0.9 * (sew "[t t f t f t t f]*2" "[0.8|0.7|0.6]*16" 0.99))
vPat1b = vPat1a |+ n (sew "<t!16 f!16>" (-0.2) 0.2)
vPat1 = stack [vPat1a, vPat1b]
vPat2 = (<~) (segment 1 $ irand 16 / 16) vPat1 # vowel "u"
vPat = sew "<t!8 f!99>" vPat1a $ sew "<t!8 f!8>" vPat1 vPat2
-- drums
whileF x = while "<f f f t f [f t] f [f f t]>" (ply "[2|1|1|1|1]*16") x
hh = whileF "1!16" # s "hc:0" # hpf 4444 # cut 1
hhHigh = whileF "1!16" # s "hc:0" # hpf 9999 # cut 1 # gain 1.2
kick = "<[1@3 1@5] ~>" # s "bskick:2" # speed 1.1 # gain 1.2
sd = "~ . ~ <~ 1 ~ ~  ~ 1 ~ 1>" # s "snare:0" # gain 1.45 # speed 1.1
-- bs
bs = n "c/2" # octave 3 # s "supermandolin" # vowel "u" # legato 7 # cut 1 # room 1 # orbit 2
-- final pats
hc = gain "0.8 0.5" # s "hc hc"
finalPat = stack [
  vPat,
  hh,
  hhHigh,
  kick,
  sd,
  bs
  ]
seqPLoopPat = seqPLoop [
  (0, 900, finalPat),
  (996, 999, hc),
  (999, 1000, "1 1 1 1" # s "hc:0" # hpf 4444 # gain 0.6)
  ]
in do
  hush
  setcps 0.44
  setCycle 0
  d1 $ seqPLoopPat
