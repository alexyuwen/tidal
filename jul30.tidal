-- 0?
-- Here's the third and final one in the suite. Inspired by Croatian string band, this one keeps the tempo of the previous two and sets a pattern of increasing subdivision: 8, 9, 10.
let
-- violins
-- v
vS = s "violin" # vowel "i" # octave 6 # legato 0.88 # gain 0.6
vN = n (scale "major" "[[1, 3] ~ [3, 5] ~ 1 . [0, 2] ~ [2, 4] ~ 0 . [0, 1] ~ [1, 3] ~ -1 . <[0 ~ 1 ~ 2] [0 ~ ~ ~ ~] [0 ~ 1 ~ 2] [0 ~ 1 ~ 2]>]")
v = vN # vS
-- v2
v2S = s "violin" # vowel "u" # octave 7 # legato 0.88 # gain 0.59
v2Notes = "7 ~ 7 6 5 . 4 ~ 4 3 2 . 3 ~ 3 2 1 . <[2 3 4 ~ 0] [2 ~ ~ ~ ~] [2 3 4 ~ 0] [0 ~ ~ ~ ~]>"
v2N = n (scale "major" v2Notes)
v2 = v2N # v2S
-- bs
bsGain = 0.84 * "[<0.92 1 1.09 1> ~ <0.84 _ _ 0.97> 0.84 0.79]*4" -- tied to bsI
bs = s "pluck:1" # gain bsGain # legato 9 # cut 0
offset = 0.82 * 0.5 * (2 ** 0.5)
speeds = [offset * 2 ** (i / 12) | i <- [0, 2, 4, 5, 7, 9, 11, 12, 14, 16, 17, 19, 21, 23, 24, 26]]
bsI = "3 ~ 3 5 7 . 0 ~ 0 2 4 . -3 ~ -3 -1 1 . 0 ~ 0?0.2 ~ ~"
bsNotes = speed (fit 0 speeds $ 7 + bsI)
bsPat = bsNotes # bs
-- gtr
gtrS = s "supermandolin" # vowel "i" # legato "2.75@3 10" # lpf 6666 # gain 0.92 # cut 0 # room 0.12 # orbit 5
gtrNotes = "[[-4] ~ [-4, -2, 1] ~ ~ . ~ ~ [-3, 0, 2] ~ ~ . ~ ~ [-3, -1, 1] ~ ~ . <[-3, 0, 2] [-3, 0]> ~ ~ ~ ~]"
gtr = n (scale "major" gtrNotes) # gtrS
-- rhythm
hh = s "hc:0" # vowel "a" # cut 1 # gain 0.69 # orbit 4
hhMask = mask (fast 6.6 $ wchoose [(False, 1), (True, 15)])
hhN = n $ sew "<t t t [t@3 f]>" ((<~) (segment 1 $ irand 20 / 20) "1([11|12|12|13],20)") "[1 _ 1 _ 1]*4"
hhPat = hhMask $ hhN # hh
sd = s "snare:0" # gain 0.56 # speed 2.2
sdPat = "[~ ~ 1 ~ <~ ~ ~ 1>]*4" # sd
-- final TODO all instruments come in and out randomly for chaotic texture
bitePat = outside 4 (bite 16 $ ply 2 "[0..15]/2")
bitePat2 = outside 4 (bite 16 $ "[0 0 1 1 0 0 <7 1> !]*2")
f1 = stack [
  bitePat2 v,
  bitePat2 gtr,
  hhPat
  ]
f2 = stack [
  v,
  gtr,
  hhPat
  ]
f3 = stack [
  bitePat v,
  bitePat v2,
  bitePat gtr,
  bitePat sdPat,
  hhPat
  ]
f4 = stack [
  v,
  v2,
  gtr,
  bsPat,
  sdPat,
  hhPat
  ]
seqPLoopPat2 = seqPLoop [
  (0, 4, f1),
  (4, 8, f2),
  (8, 16, f3),
  (16, 24, f4),
  (992, 999, gain "0.8 0.5" # s "hc hc"),
  (999, 1000, "1" # hh)
  ] |* gain 1.06
seqPLoopPatZ = seqPLoop [
  (0, 4, f1),
  (4, 8, f2),
  (8, 16, f3),
  (16, 20, f1),
  (20, 24, f1),
  (24, 32, f3),
  (32, 48, f4)
  ] |* gain 1.06
seqPLoopPat = seqPLoop [
  (0, 4, f1),
  (4, 8, f2),
  (8, 12, f1),
  (12, 20, f4)
  ] |* gain 1.06
in do
  hush
  setcps 0.44
  setCycle 0
  d1 $ seqPLoopPat
