--
-- As the third in the suite, this one continues the tempo of the previous two as well as the pattern of increasing subdivision: 8, 9, 10.
-- TODO violin harmonizations
let
-- violins
-- v
vS = s "violin" # vowel "i" # octave 6 # legato 0.88 # gain 0.65
vN = n (scale "major" "[[1, 3] ~ [3, 5] ~ 1 . [0, 2] ~ [2, 4] ~ 0 . [0, 1] ~ [1, 3] ~ -1 . <[0 ~ 1 ~ 2] [0 ~ ~ ~ ~] [0 ~ 1 ~ 2] [0 ~ 1 ~ 2]>]")
v = vN # vS
-- v2
v2S = s "violin" # vowel "u" # octave 7 # legato 0.88 # gain 0.66
v2Notes = "7 ~ 7 6 5 . 4 ~ 4 3 2 . 3 ~ 3 2 1 . <[2 3 4 ~ 0] [2 ~ ~ ~ ~] [2 3 4 ~ 0] [0 ~ ~ ~ ~]>"
v2N = n (scale "major" v2Notes)
v2 = v2N # v2S
-- bs
bsGain = 0.98 * "[<0.92 1 1.08 1> ~ <0.84 _ _ 0.97> 0.84 0.79]*4" -- tied to bsI TODO bs2 different gain, and softer for hc solo
bs = s "pluck:1" # gain bsGain # legato 9 # cut 1 -- cut 0 for fast line, cut 1 for slow line
offset = 0.82 * 0.5 * (2 ** 0.5) -- 0.82 for C major, manually tuned
speeds = [offset * 2 ** (i / 12) | i <- [0, 2, 4, 5, 7, 9, 11, 12, 14, 16, 17, 19, 21, 23, 24, 26]]
bsI = "3 ~ 3 5 7 . 0 ~ 0 2 4 . -3 ~ -3 -1 1 . 0 ~ 0?0.33 ~ ~"
bsI2 = "3 ~ [3|7] ~ ~ . 0 ~ [0|4] ~ ~ . -3 ~ [-3|4] ~ ~ . 0 ~ 0?0.33 ~ ~"
bsNotes = speed (fit 0 speeds $ 7 + bsI)
bsPat = bsNotes # bs
-- gtr
gtrS = s "supermandolin" # vowel "i" # legato "2.75@3 10" # lpf 6666 # gain 0.94 # cut 0 # room 0.12 # orbit 5
gtrNotes = "[[-4] ~ [-4, -2, 1] ~ ~ . ~ ~ [-3, 0, 2] ~ ~ . ~ ~ [-3, -1, 1] ~ ~ . <[-3, 0, 2] [-3, 0]> ~ ~ ~ ~]"
gtr = n (scale "major" gtrNotes) # gtrS
-- rhythm
hh = s "hc:0" # vowel "a" # cut 1 # gain 0.7 # orbit 4
-- hhMid = "[1@2 1@3]*4" # hh
hhMask = mask (fast 6.6 $ wchoose [(False, 1), (True, 15)])
hhN = n $ sew "<t t t [t@3 f]>" ((<~) (segment 1 $ irand 20 / 20) "1([11|12|12|13],20)") "[1 _ 1 _ 1]*4"
hhPat = hhMask $ hhN # hh
kick = "[~ _ 1 _ _]*4" # s "bskick:2" # vowel "i" # speed 1 # gain 0.8 # room 0.12 # orbit 3
sd = n "1 1" # s "snare:0" # gain 0.54 # speed 1.1
-- final
final = stack [ -- TODO all instruments come in and out randomly for chaotic texture
  -- v,
  v2,
  -- gtr
  -- bsPat,
  -- kick,
  -- hhPat
  ]
seqPLoopPat = seqPLoop [
  (0, 4, final),
  (0, 900, final),
  (0, 900, final),
  (0, 900, final),
  (992, 999, gain "0.8 0.5" # s "hc hc"),
  (999, 1000, "1" # hh)
  ]
in do
  hush
  setcps 0.44
  setCycle 0
  d1 $ seqPLoopPat
