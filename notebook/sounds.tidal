-- Cool tones.  Pitch from rhythm
d1 $ n "0*90" # octave 1 # s "acidOto3091" # gain 1.8 # legato 0.4
d1 $ n "0*109.7" # octave 1 # s "superhammond" # gain 1.8 # legato 0.4
d1 $ n 0 # octave 2 # s "superhammond" # voice 7




-- pluck bass from joropo
bass = s "pluck:1" # gain 1.33 # legato 9
offset = 1.172 * 0.5 * (2 ** 0.5)
speeds = [offset * 2 ** (i / 12) | i <- [0, 2, 4, 5, 7, 9, 11, 12, 14, 16, 17, 19, 21, 23, 24]]
bassNotes = speed (fit 0 speeds $ 7 + "~ 0 4 ~ -3 4")
